# In local dev the client talks to the backend through Vite's dev proxy (see vite.config.js),
# so nothing is required here as long as the API runs on http://127.0.0.1:5000.

# If you change PORT in server/.env, point the proxy at the new port:
# VITE_API_PROXY_TARGET=http://127.0.0.1:5001

# If you deploy frontend and backend separately, set the absolute API origin (no trailing slash).
# The backend's CLIENT_URL must then include your frontend origin (CORS).
# VITE_API_URL=https://api.yourdomain.com

{
  "name": "habit-tracker-server",
  "version": "1.1.0",
  "description": "Backend API for the AI-powered habit tracker",
  "main": "server.js",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node scripts/seed.js",

    "date-fns": "^3.6.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.7",
    "nodemon": "^3.1.0",
    "supertest": "^7.2.2",
    "vitest": "^3.2.7"
  }
